# Copied to config/local.env by setup.bat, which replaces WORKER_TOKEN with a random value.
# Paths are relative to the project root (specs/02-architecture.md#storage-replaces-minio).

# Ports
BACKEND_PORT=8080
WORKER_HOST=127.0.0.1
WORKER_PORT=8090
OLLAMA_URL=http://127.0.0.1:11434

# Paths
MEDIA_DIR=media
DATA_DIR=data
LOGS_DIR=logs
MODELS_DIR=models
LUTS_DIR=luts
SFX_DIR=sfx
TOOLS_DIR=tools

# Shared secret for worker <-> backend calls (header X-Worker-Token)
WORKER_TOKEN=change-me
