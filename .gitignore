# Generated media, weights, databases and logs stay local (specs/02-architecture.md).
# The folders themselves are kept with a .gitkeep so a clean copy has the full layout.
/media/*
!/media/.gitkeep
/models/*
!/models/.gitkeep
/data/*
!/data/.gitkeep
/logs/*
!/logs/.gitkeep
/tools/*
!/tools/.gitkeep

# Secrets and machine-specific config
/config/local.env

# Free assets downloaded by setup.bat
/luts/*
!/luts/.gitkeep
/sfx/*
!/sfx/.gitkeep

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
.coverage
htmlcov/

# Node / Angular
node_modules/
.angular/
/frontend/dist/
/frontend/coverage/

# Java / Maven
target/
!.mvn/wrapper/maven-wrapper.jar

# Angular build copied into the backend by setup.bat
/backend/src/main/resources/static/

# Editors and OS
.idea/
*.iml
.vscode/
Thumbs.db
Desktop.ini
.DS_Store
